# ─────────────────────────────────────────────────────────────────────────────
# Megapot Starter Kit — environment variables
#
# Copy this file to .env and fill in the values:
#   cp .env.example .env
# ─────────────────────────────────────────────────────────────────────────────

# ─────────────────────────────────────────────────────────────────────────────
# Referrer attribution — the one value most forks should change
#
# You earn the protocol's referral fee on every ticket purchased and the
# referral win share on every winning claimed through your app. Both
# rates are protocol-level and readable at runtime via
# `Jackpot.getDrawingState().referralFee` / `.referralWinShare` (1e18).
#
# Default below is a dead address — the kit ships with this so a fresh
# fork runs end-to-end without any config, but any fees earned on that
# address are unrecoverable. Set this to your wallet before you ship.
# See https://llms.megapot.io/tasks/claim-referral-fees for the
# claim flow.
# ─────────────────────────────────────────────────────────────────────────────

# Wallet that earns referral fees. Must be a non-zero EVM address — the
# Jackpot contract reverts with `ZeroAddress()` on `0x0…0`.
VITE_REFERRER_ADDRESS=0x000000000000000000000000000000000000dEaD

# ─────────────────────────────────────────────────────────────────────────────
# Chain + RPC
#
# These two vars must agree. Switching VITE_CHAIN=testnet requires also
# flipping VITE_RPC_URL to a Sepolia endpoint; otherwise hooks will silently
# read mainnet state with testnet contract addresses (or vice versa).
# ─────────────────────────────────────────────────────────────────────────────

# Chain to use. Determines which contract addresses + RPC are wired up.
#   mainnet — Base mainnet (production), chain ID 8453
#   testnet — Base Sepolia (free test USDC), chain ID 84532
VITE_CHAIN=mainnet

# RPC endpoint for the active chain.
#
# DEFAULT (public RPC): rate-limited, fine for casual local dev only.
# For reliable testing or production, swap to a free dedicated endpoint:
#   - Alchemy:  https://www.alchemy.com/base   (free tier covers most dev needs)
#   - Goldsky:  https://goldsky.com            (Edge endpoints, low-latency)
#   - QuickNode, Infura, Ankr, etc. — any HTTPS Base RPC works.
#
# Pick the line that matches VITE_CHAIN above:
VITE_RPC_URL=https://mainnet.base.org
# VITE_RPC_URL=https://sepolia.base.org

# ─────────────────────────────────────────────────────────────────────────────
# Wallet provider
# ─────────────────────────────────────────────────────────────────────────────

# WalletConnect project ID. Get a free one at https://cloud.walletconnect.com
# (~2 min signup). Without a real ID, injected wallets (MetaMask, Coinbase
# Wallet) still work for local dev — only the WalletConnect QR modal breaks.
#
# Free tier MAU quota is ~10K monthly active users; busy production forks
# that hit the cap will see modal connection errors. Upgrade in the
# WalletConnect Cloud dashboard or self-host if you exceed it.
VITE_WALLETCONNECT_PROJECT_ID=

# App name shown in wallet-connect modals (RainbowKit / WalletConnect).
# Set this on rebrand. Falls back to "Megapot Starter Kit" if empty.
VITE_APP_NAME=

# ─────────────────────────────────────────────────────────────────────────────
# Megapot Data API — three tiers of key handling. Pick one.
#
#   1. Anonymous (default)
#      Leave VITE_MEGAPOT_API_KEY empty, leave VITE_API_BASE_URL empty.
#      Browser hits api.megapot.io directly, rate-limited (10/min, 500/day).
#      Works on any static host (Vercel static, Cloudflare Pages, GitHub
#      Pages, S3 + CloudFront, etc.).
#
#   2. Browser key — simplest higher-tier path
#      Set VITE_MEGAPOT_API_KEY. Higher tier (60/min, 10K/day).
#      The key ships to the browser bundle (Vite injects VITE_* at build).
#      That's acceptable for the read-only Data API — rate-limited per
#      key, revocable from the dashboard. Rotate if it leaks.
#      Still static-host friendly.
#
#   3. Proxy — key never reaches the browser
#      Set MEGAPOT_API_KEY (no VITE_ prefix, server-side env only) AND
#      VITE_API_BASE_URL=/api/megapot. Requires a backend to deploy
#      server/proxy.ts on — see examples/ for Vercel Functions and
#      Cloudflare Workers wrappers. Use this when you have a privileged
#      key or your fork is multi-tenant.
#
# Get a key from https://megapot.io/dashboard (sign in first). Copy once
# and store like a password — Megapot does not retain a retrievable copy.
# Full reference: https://llms.megapot.io/data-api § "Get a Key".
# ─────────────────────────────────────────────────────────────────────────────

# Browser-injected Data API key (tier 2). Empty = anonymous (tier 1).
VITE_MEGAPOT_API_KEY=

# Override the Data API base URL. Set to /api/megapot for the proxy tier
# (tier 3). Empty = default https://api.megapot.io/v1.
VITE_API_BASE_URL=

# Server-side Data API key (tier 3 only). Read by server/proxy.ts; never
# exposed to the browser. Do NOT prefix with VITE_.
# MEGAPOT_API_KEY=
